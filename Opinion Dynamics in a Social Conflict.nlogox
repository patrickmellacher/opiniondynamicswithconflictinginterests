breed [humans human]

extensions [nw]
;extensions [nw profiler]

humans-own
[
  true_interest ;0 for non-polluters, 1 for polluters
  belief
  belief_old
  payoff
  funds
  advertised_views
  cautiousness_parameter_this_agent
]

globals
[
  number_typeA_agents
  number_typeB_agents
  typeA_agents
  typeB_agents
  median_voter
  stdv_belief
  humans_sorted_links
  humans_sorted_fixed
  median_voter_history
  stdv_belief_history
  median_voter_mean
  stdv_belief_mean
  gini
  sum_payoffs
  median_voter_stdv
]

to setup
  clear-all
  ask patches
  [
    set pcolor green
  ]
  if network_type = "random_network"
  [
    nw:generate-random humans links number_agents randomnetwork_chance
    [
      create_agent
    ]
  ]
  if network_type = "watts_strogatz"
  [
    nw:generate-watts-strogatz humans links number_agents neighborhood_size rewire_probability
    [
      create_agent
    ]
  ]

  if network_type = "preferential_attachment"
  [
    nw:generate-preferential-attachment humans links number_agents min_degree
    [
      create_agent
    ]
  ]

  if network_type = "homophilic_network" or network_type = "homogenous mixing"
  [
    create-humans number_agents
    [
      create_agent
    ]
  ]

  set_typeA_agents
  set_typeB_agents

  if network_type = "homophilic_network"
  [

    generate_homophilic_network min_degree homophily
  ]

  ;every agent has at least one link!
  if any? humans with [count my-links = 0] and network_type != "homogenous mixing"
  [
    ask humans with [count my-links = 0]
    [
      create-link-with one-of (other humans) with-min [count links]
    ]
  ]

  set humans_sorted_links sort-on [ (-  count my-links)] humans
  set humans_sorted_fixed sort humans

  ;layout-circle humans 15


  set median_voter_history []
  set stdv_belief_history []

  ask links
  [
    hide-link
    ;set shape "dashed"
    ;set size 0.1
  ]

  update_statistics
  if print_csv
  [
    file-close-all
    if file-exists? (word file_name ".csv")
    [
      file-delete (word file_name ".csv")
      file-open (word file_name ".csv")
      file-print "agent_id,true_interest,period,belief,payoff"
      file-close-all
    ]
  ]



  reset-ticks

end

to go
  ;update_social_network_beliefs
  conduct_advertisement
  update_beliefs_network_and_advertisements
  ;compute_advertisements
  update_outside_information
  update_statistics
  compute_payoffs
  calc_gini
  if print_csv
  [
    print_agent_positions
  ]
  tick
end

to create_agent
  set shape "circle"
  set size 0.02
  set belief min ( list 1 max (list 0 random-normal belief_mean belief_sd))
  set xcor random-xcor
  set_color
  set advertised_views []
end

to generate_homophilic_network [min_degree_homophily homophily_parameter]
 ask typeA_agents
 [
    create-links-with up-to-n-of (ceiling min_degree_homophily * ( 1 - homophily_parameter)) (other humans)
    create-links-with up-to-n-of (floor min_degree_homophily * homophily_parameter) (other typeA_agents)
 ]
   ask typeB_agents
 [
    create-links-with up-to-n-of (ceiling min_degree_homophily * ( 1 - homophily_parameter)) (other humans)
    create-links-with up-to-n-of (floor min_degree_homophily * homophily_parameter) (other typeB_agents)
 ]
end

to set_typeA_agents
  set typeA_agents (turtle-set)
  set number_typeA_agents (share_typeA / 100 * number_agents)
  ask up-to-n-of number_typeA_agents humans
  [
    ifelse conflicting_interests = TRUE
    [
      set true_interest 1
    ]
    [
      set true_interest 0.5
    ]
    set cautiousness_parameter_this_agent cautiousness_parameter_typeA
    set typeA_agents (turtle-set typeA_agents self)
  ]
end

to set_typeB_agents
  set typeB_agents (turtle-set)
  set number_typeB_agents number_agents - number_typeA_agents
  ask humans with [true_interest = 0]
  [
    set typeB_agents (turtle-set typeB_agents self)
    ifelse conflicting_interests = TRUE
    [
      set true_interest 0
    ]
    [
      set true_interest 0.5
    ]
    set cautiousness_parameter_this_agent cautiousness_parameter_typeB
  ]
end

to set_converging_interests
  set typeA_agents (turtle-set)
  set number_typeA_agents (share_typeA / 100 * number_agents)
  ask up-to-n-of number_typeA_agents humans
  [
    set true_interest 0.5
    set typeA_agents (turtle-set typeA_agents self)
  ]

  set typeB_agents (turtle-set)
  set number_typeB_agents number_agents - number_typeA_agents
  ask humans with [true_interest = 0]
  [
    set typeB_agents (turtle-set typeB_agents self)
    set true_interest 0.5
    ;set polluter 0
  ]
  ;set
  ;set typeB_agents (turtle-set)
  ;set number_typeB_agents number_agents
;  ask humans with [true_interest = 0]
;  [
;    set typeB_agents (turtle-set typeB_agents self)
;    set true_interest 0.5
;  ]
end

to update_outside_information
;  if conflicting_interests = TRUE
;  [
    ask up-to-n-of ((chance_true_belief_typeA) / 100 * number_typeA_agents) typeA_agents
    [
      set belief true_interest
      set_color
    ]
;  ]

  ask up-to-n-of ((chance_true_belief_typeB) / 100 * number_typeB_agents) typeB_agents
  [
    set belief true_interest
    set_color
  ]
end


to update_beliefs_network_and_advertisements
  ask humans
  [
    set belief_old belief
  ]
  ask humans
  [

    let average_belief_within_confidence_bound mean (sentence belief_old [belief_old] of link-neighbors with [abs (belief_old - [belief_old] of myself) <= bounded_confidence])
    ;let cumulative_advertisement_parameter 0;min (list (1 - persuasion_parameter) (1 - (1 - persuasion_parameter_advertisements) ^ length advertised_views))
    let mean_advertised_views -1
    ifelse length advertised_views > 0
    [
      set mean_advertised_views mean advertised_views
      set belief average_belief_within_confidence_bound * (1 - persuasion_parameter_advertisements) + mean_advertised_views * persuasion_parameter_advertisements
      ;set cumulative_advertisement_parameter min (list (1 - persuasion_parameter) persuasion_parameter_advertisements)
    ]
    [
      set belief average_belief_within_confidence_bound
    ]
    ;ifelse other_belief >= 0
    ;[
    ;  set belief belief * (1 - persuasion_parameter - cumulative_advertisement_parameter) + other_belief * persuasion_parameter + mean_advertised_views * cumulative_advertisement_parameter
    ;]
    ;[
    ;  set belief belief * (1 - cumulative_advertisement_parameter) + mean_advertised_views * cumulative_advertisement_parameter
    ;]
    set advertised_views []
    set_color
  ]


end

to set_color
  set color abs (max (list belief 0.01)  - 1) * 10
  set ycor min (list 0.49 (belief - 0.49))
end

to update_statistics
  set median_voter median [belief] of humans
  set stdv_belief standard-deviation [belief] of humans

  set median_voter_history fput median_voter median_voter_history
  set stdv_belief_history fput stdv_belief stdv_belief_history

  if length median_voter_history > 500
  [
    set stdv_belief_history but-last stdv_belief_history
    set median_voter_history but-last median_voter_history
  ]
  set sum_payoffs sum [payoff] of humans
  if length median_voter_history > 2
  [set median_voter_stdv standard-deviation median_voter_history]
  set median_voter_mean mean median_voter_history
  set stdv_belief_mean mean stdv_belief_history

end

to compute_payoffs

  ask typeA_agents
  [
    set payoff (((1 - abs (true_interest - median_voter) ) ^ deviation_parameter ) * payoff_full / number_typeA_agents) * payoff_multiplier_typeA
    ifelse dynamic_investments
    [
      set funds funds + abs (belief - median_voter) * payoff
    ]
    [
      set funds funds + payoff
    ]
    
  ]

  ask typeB_agents
  [
    set payoff (((1 - abs (true_interest - median_voter) ) ^ deviation_parameter ) * payoff_full / number_typeB_agents) * payoff_multiplier_typeB
    ifelse dynamic_investments
    [
      
      set funds funds + abs (belief - median_voter) * payoff
    ]
    [
      set funds funds + payoff
    ]
  ]
end

to conduct_advertisement

  ask humans with [funds >= 1]
  [
    let actual_belief belief
    let propagated_view belief;for advertisement strategy "current belief" - agents simply propagate their economic interests
    if advertisement_strategy = "strategic"
    [
      ifelse belief >= median_voter
      [
        set propagated_view min (list belief (median_voter + bounded_confidence * cautiousness_parameter_this_agent))
        ;print propagated_view
      ]
      [
        set propagated_view max (list belief (median_voter - bounded_confidence * cautiousness_parameter_this_agent))
      ]
    ]
    let number_advertisement_targets floor funds
    set funds funds - number_advertisement_targets
    let advertisement_target_list []
    if advertisement_target = "random"
    [
      set advertisement_target_list (list up-to-n-of number_advertisement_targets other humans)
    ]
    if advertisement_target = "influencer"
    [
      set advertisement_target_list remove self humans_sorted_links
    ]
    if advertisement_target = "fixed"
    [
      set advertisement_target_list remove self humans_sorted_fixed
    ]
    if advertisement_target = "efficient"
    [
      let true_interest_this_agent true_interest
      set advertisement_target_list sort-on [ (- abs (belief - propagated_view )) ] (other humans with [ abs (propagated_view - belief) < bounded_confidence and (( belief < actual_belief and not (belief > propagated_view)) or   ( belief > actual_belief and not (belief < propagated_view)))])
    ]

    while [number_advertisement_targets > 0 and length advertisement_target_list > 0]
      [

        ask first advertisement_target_list
        [
          if abs (propagated_view - belief) <= bounded_confidence
          [
            ;set belief belief * (1 - persuasion_parameter_advertisements) + propagated_view * persuasion_parameter_advertisements
            set advertised_views lput propagated_view advertised_views
          ]
          set_color
        ]
        set advertisement_target_list but-first advertisement_target_list
        set number_advertisement_targets number_advertisement_targets - 1
    ]
  ]
end

to compute_advertisements
  ask humans with [length advertised_views > 0]
  [
    let cumulative_advertisement_parameter (1 - (1 - persuasion_parameter_advertisements) ^ length advertised_views)
    set belief belief * ( 1 - cumulative_advertisement_parameter) + mean advertised_views * cumulative_advertisement_parameter
    set advertised_views []
  ]
end

to print_agent_positions

  file-open (word file_name ".csv")
  ask humans
  [
    file-print (word who "," true_interest "," ticks "," belief "," payoff)
  ]
  file-close-all
end

to calc_gini

  let humans_list sort [  payoff ] of humans
  let humans_list_length length humans_list
  let calculated_sum 0
  let i 1
  foreach humans_list
  [ x ->
    set calculated_sum calculated_sum + x * (2 * i - humans_list_length - 1)
    set i i + 1
  ]
  if humans_list_length = 1
  [
    set calculated_sum 1
  ]
  set gini 1 / ( humans_list_length ^ 2 * mean humans_list) * calculated_sum

end]]></code>
